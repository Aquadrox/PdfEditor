{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PdfEditor",
  "identifier": "fr.aquadrox.pdfeditor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PdfEditor",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' pde: http://pde.localhost; style-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PdfEditor.pdf",
        "description": "Document PDF",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Aquadrox/PdfEditor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2RjEyMzA1NTA0NzVDNjYKUldSbVhFZFFCU1B4MW5mNHpUaS91ZkNyL0dSTnZnZUhWRzE0ZG5uUEl2bEl3N3BzOGxKR1FRYUYK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
