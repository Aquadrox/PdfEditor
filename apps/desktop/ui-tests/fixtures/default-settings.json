{
  "general": {
    "theme": "system",
    "recent_files": 10,
    "reopen_last": false
  },
  "display": {
    "default_zoom": "fit_width",
    "page_cache_mb": 256
  },
  "edit": {
    "author": "",
    "font": "sans",
    "font_size": 11.0,
    "text_color": "#1c2430",
    "highlight_color": "#ffd54a",
