    "zoom_in": "Ctrl+Plus",
    "zoom_out": "Ctrl+Minus",
    "zoom_reset": "Ctrl+0",
    "fit_page": "Ctrl+1",
    "fit_width": "Ctrl+2",
    "settings": "Ctrl+Comma",
    "undo": "Ctrl+Z",
    "redo": "Ctrl+Y",
    "save": "Ctrl+S",
    "save_as": "Ctrl+Shift+S"
  },
  "updates": {
    "check": true
